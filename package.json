{
  "name": "cc-guard",
  "version": "0.3.0",
  "description": "Keep Claude on the dedicated line you chose in Clash, and switch Claude accounts safely (Windows).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/shiqiyux-cmd/CC-Guard",
  "repository": {
    "type": "git",
    "url": "https://github.com/shiqiyux-cmd/CC-Guard.git"
  },
  "bugs": {
    "url": "https://github.com/shiqiyux-cmd/CC-Guard/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:windows": "bun run build && bun run tauri build --config src-tauri/tauri.windows.conf.json --features custom-protocol",
    "tauri": "tauri",
    "test": "bun test",
    "test:windows": "python scripts/test-windows.py",
    "test:identities": "node --experimental-strip-types scripts/test-identities-ui.ts",
    "test:ui": "node --experimental-strip-types scripts/test-ui.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.3",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5",
    "playwright-core": "1.64.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "yaml": "^2.9.1"
  }
}
